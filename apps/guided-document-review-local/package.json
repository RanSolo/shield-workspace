{
  "name": "@shield/guided-document-review-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare:pr-review": "node scripts/prepare-pr-review.mjs",
    "serve": "npm run build && node scripts/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "nx": {
    "tags": [
      "scope:guided-review",
      "type:app"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  },
  "devDependencies": {
    "esbuild": "0.25.9",
    "typescript": "5.4.5"
  },
  "dependencies": {
    "@shield/guided-document-review": "0.1.0",
    "@shield/guided-pr-review": "^0.1.0",
    "markdown-it": "15.0.1"
  }
}
