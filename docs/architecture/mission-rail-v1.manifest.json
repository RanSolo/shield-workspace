{
  "schemaId": "shield.track-layer.factory-program.v1",
  "schemaVersion": 1,
  "programId": "mission-rail-v1",
  "status": "proposed",
  "constructionMode": "track-layer",
  "primaryHost": "factory",
  "architecture": {
    "humanOverviewPath": "docs/architecture/mission-rail-v1-overview.md",
    "referencePath": "docs/architecture/mission-rail-v1.md",
    "maintainabilityPath": "docs/architecture/mission-rail-maintainability.md",
    "factoryBootstrapPath": "docs/architecture/mission-rail-factory-bootstrap.md",
    "binding": "same-git-tree"
  },
  "sourceBaseline": {
    "repositoryId": "RanSolo/shield-workspace",
    "revision": "af4c3a76c8c65def029dce2e68c25f556b2790d7",
    "existingProjects": [
      "@shield/mission-preparation",
      "@shield/multiband",
      "@shield/team-system"
    ]
  },
  "goBindingRequiredFields": [
    "accountableHumanId",
    "acceptedFeatureIds",
    "architectureGitRevision",
    "architectureRawSha256",
    "autonomyLevel",
    "budgetAndExpiry",
    "effectEnvelope",
    "factoryMissionPlanSha256",
    "featureManifestRawSha256",
    "milestoneIds",
    "ownedPathUnion",
    "recordedAt"
  ],
  "epicWheelsUp": {
    "scope": "accepted_feature_graph_and_bounded_corrections",
    "reviewCadence": "architecture_before_go_then_milestone_and_epic_completion",
    "perIssuePinRequired": false,
    "materialAmendmentRequiredFor": [
      "new_product_outcome",
      "owned_path_expansion",
      "destructive_effect",
      "merge",
      "deployment",
      "release"
    ]
  },
  "defaultEffects": {
    "allowedAfterGo": [
      "repository.read",
      "repository.write_owned_paths",
      "process.run_declared_validation",
      "git.create_feature_branch",
      "git.commit",
      "git.push_feature_branch",
      "github.create_draft_pull_request"
    ],
    "excluded": [
      "delete_existing_shield_runtime",
      "deployment",
      "destructive_migration",
      "merge",
      "release"
    ]
  },
  "identityEvidenceFields": [
    "accountableSeatId",
    "factoryFeatureId",
    "factoryMissionId",
    "hostKind",
    "modelId",
    "reasoningRuntimeId",
    "runId",
    "toolExecutorId"
  ],
  "integration": {
    "branch": "integration/mission-rail-v1",
    "ownedPaths": [
      ".github/workflows/**",
      "eslint.config.*",
      "nx.json",
      "package-lock.json",
      "package.json",
      "sonar-project.properties",
      "tsconfig*.json"
    ],
    "baseAdvancement": {
      "actor": "factory-parent-mission",
      "requires": [
        "all_dependencies_integrated",
        "exact_integration_tree",
        "milestone_validation_when_boundary_reached",
        "unchanged_feature_scope_paths_effects_and_dependencies"
      ],
      "output": "integration-receipt.v1",
      "regeneratesDownstreamPacketIdentity": true
    },
    "genesisReceipt": {
      "schemaId": "integration-receipt.v1",
      "createdBy": "epic-wheels-up",
      "candidateTree": "accepted architecture Git tree",
      "predecessorReceiptDigest": null,
      "binding": "GO digest plus architecture revision plus manifest digest",
      "purpose": "exact base for MR-000 before any feature receipt exists"
    }
  },
  "featurePacketDefaults": {
    "architectureSource": {
      "path": "docs/architecture/mission-rail-v1.md",
      "binding": "same-git-tree"
    },
    "exactBaseDerivation": "terminal accepted integration-receipt.v1 candidateTree",
    "excludedBehavior": [
      "legacy_runtime_rewrite",
      "undeclared_compatibility",
      "unowned_path_change"
    ],
    "excludedEffects": [
      "delete_existing_shield_runtime",
      "deployment",
      "destructive_migration",
      "merge",
      "release"
    ],
    "factory": {
      "mode": "mission",
      "autonomy": "bounded_by_epic_wheels_up",
      "parallelism": "only_after_named_dependencies_with_disjoint_owned_paths"
    },
    "requiredArtifacts": [
      "exact_candidate_revision",
      "changed_path_manifest",
      "nx_validation_receipt",
      "cache_status",
      "implementation_summary",
      "typed_handoff"
    ]
  },
  "featurePacketResolution": {
    "manifestIsSoleAcceptedFeatureGraph": true,
    "githubIssuesAreDeliveryIndexesCreatedFromFeatureIds": true,
    "verifier": "tools/mission-rail/verify-packets.mjs",
    "mergeOrder": "featurePacketDefaults_then_feature_record",
    "materialization": {
      "outcome": "feature.title",
      "exactBase": "resolved terminal integration receipt candidateTree",
      "factory.milestone": "feature.milestone",
      "packetDigestBinding": [
        "materialized packet canonical digest",
        "manifest canonical digest",
        "integration receipt canonical digest"
      ]
    },
    "rejectUnknownOrMissingFields": true
  },
  "qualityTargets": {
    "project": "mission-rail-quality",
    "revisionResolution": "resolve-revisions uses the GO-bound genesis receipt for MR-000 and the terminal accepted integration receipt thereafter; it verifies receipt base and current Git HEAD as full object IDs and their lineage, then writes a locally ignored content-addressed revisions/<receipt-digest>/<head-digest>.json consumed by later targets",
    "revisionResolutionCache": false,
    "staleInputRule": "every consumer verifies receipt digest base head and current repository tuple before work; mismatch rejects the input",
    "commands": [
      "npm exec nx run mission-rail-quality:resolve-revisions",
      "npm exec nx run mission-rail-quality:verify-packets",
      "npm exec nx run mission-rail-quality:affected",
      "npm exec nx run mission-rail-quality:cache-proof",
      "npm exec nx run mission-rail-quality:package-surface",
      "npm exec nx run mission-rail-quality:sonar",
      "npm exec nx run mission-rail-quality:sonar-gate",
      "npm exec nx run mission-rail-quality:proving-flight"
    ]
  },
  "milestoneValidation": {
    "foundation": [
      "npm exec nx run mission-rail-quality:resolve-revisions",
      "npm exec nx run mission-rail-quality:verify-packets",
      "npm exec nx run @shield/mission-rail:property-test",
      "npm exec nx run @shield/mission-rail:mutation-test",
      "npm exec nx run mission-rail-quality:affected",
      "npm exec nx run mission-rail-quality:cache-proof",
      "npm exec nx run mission-rail-quality:sonar-gate"
    ],
    "lifecycle": [
      "npm exec nx run mission-rail-quality:resolve-revisions",
      "npm exec nx run @shield/mission-store:property-test",
      "npm exec nx run @shield/mission-store:mutation-test",
      "npm exec nx run mission-rail-quality:affected",
      "npm exec nx run mission-rail-quality:cache-proof",
      "npm exec nx run mission-rail-quality:package-surface",
      "npm exec nx run mission-rail-quality:sonar-gate"
    ],
    "vertical-flight": [
      "npm exec nx run mission-rail-quality:resolve-revisions",
      "npm exec nx run mission-rail-quality:affected",
      "npm exec nx run mission-rail-quality:cache-proof",
      "npm exec nx run mission-rail-quality:package-surface",
      "npm exec nx run mission-rail-quality:sonar-gate",
      "npm exec nx run mission-rail-quality:proving-flight"
    ]
  },
  "packages": [
    {
      "name": "@shield/canonical-contract",
      "runtimeDependencies": [],
      "sideEffects": "none"
    },
    {
      "name": "@shield/mission-rail",
      "runtimeDependencies": ["@shield/canonical-contract"],
      "sideEffects": "none"
    },
    {
      "name": "@shield/guided-review",
